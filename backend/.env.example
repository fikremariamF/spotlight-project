APP_NAME="Betoch Furniture"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public URL of the shop pages. Links in emails and payment return pages use it.
# With the Vite dev proxy use the frontend URL, e.g. http://localhost:5173
APP_URL=http://localhost:5173
# Public URL of this API server, only when it is not served from APP_URL (for example pages on
# Vercel, API on Railway). Photo links (API_URL/storage/...) and Chapa's callback use it.
API_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marketplace
DB_USERNAME=marketplace
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Marketplace ---------------------------------------------------------
# Temporary brand name; change once the business name is final.
MARKETPLACE_NAME="Betoch Furniture"
# Catalog browsing requests per minute (per user, or per IP for guests).
MARKETPLACE_CATALOG_RATE=300
MARKETPLACE_MAX_PRODUCT_IMAGES=8
MARKETPLACE_MAX_IMAGE_KB=5120
MARKETPLACE_REAPPROVE_ON_EDIT=true
# Starting commission rate. Once an admin saves Admin > Settings, the saved value wins.
MARKETPLACE_DEFAULT_COMMISSION_PERCENT=10
# Starting value for cash on delivery (also an admin setting). Turning it off leaves only online payment.
MARKETPLACE_COD_ENABLED=true
# Starting values for two more admin settings: unpaid commission (ETB) above which a store cannot
# confirm new orders (0 = no limit), and the payment instructions shown on each seller's balance page.
MARKETPLACE_COMMISSION_CREDIT_LIMIT=0
MARKETPLACE_SETTLEMENT_INSTRUCTIONS=

# Online payment. Gateway: none (default, online payment off), chapa, or fake (a test page in this
# app for local tries; refused when APP_ENV=production). The admin switch starts from
# MARKETPLACE_ONLINE_PAYMENTS_ENABLED. Customers have MARKETPLACE_PAYMENT_WINDOW_MINUTES to pay
# (minimum 5) before the order is cancelled and the stock released; that needs the scheduler (cron).
MARKETPLACE_PAYMENT_GATEWAY=none
MARKETPLACE_ONLINE_PAYMENTS_ENABLED=true
MARKETPLACE_PAYMENT_WINDOW_MINUTES=30
# Chapa (chapa.co). A CHASECK_TEST-... key runs Chapa's test mode. Never commit a real key.
# The webhook secret is the one set in the Chapa dashboard (Settings, Webhooks).
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_BASE_URL=https://api.chapa.co/v1

# Delivery by distance: base fee + price per km from the store's map pin to the customer's, rounded
# up to 10 birr. Admin > Delivery changes these live. Trips longer than MAX_KM, or without both pins,
# fall back to the sub-city zone fees (or the store confirms the fee).
MARKETPLACE_DELIVERY_BASE_FEE=150
MARKETPLACE_DELIVERY_PER_KM=25
MARKETPLACE_DELIVERY_MAX_KM=40
# Carrying fee per floor above the ground floor when the building has no lift (0 turns it off).
MARKETPLACE_DELIVERY_PER_FLOOR=100
# Let stores charge their own delivery fee on a listing (admins can switch this in Admin > Delivery).
MARKETPLACE_STORES_SET_DELIVERY_FEE=false
# Google Maps (console.cloud.google.com, billing must be on). Browser key: Maps JavaScript API only,
# restricted to your site's address. Server key: Routes API only, restricted to your server's IP.
# Without a server key the distance is a straight-line estimate x 1.3. Never commit real keys.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Most road-distance lookups this server asks Google for per hour; past that, distances are estimated.
GOOGLE_ROUTES_PER_HOUR=200

# Alerts. In-app alerts always work. Email and SMS are sent by the queue worker (php artisan queue:work).
# SMS driver: log (default, writes to the log and Admin > Text messages without sending) or afromessage.
MARKETPLACE_SMS_DRIVER=log
# Starting value for the Admin > Settings switch that pauses all SMS.
MARKETPLACE_SMS_ENABLED=true
# AfroMessage account (afromessage.com). Never commit a real token.
AFROMESSAGE_TOKEN=
AFROMESSAGE_IDENTIFIER_ID=
AFROMESSAGE_SENDER=
# Comma-separated list of frontend origins allowed to call the API from another domain.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Behind a hosting proxy (Railway, Render): REMOTE_ADDR, so rate limits and the audit log see each
# visitor's address. Leave empty when visitors connect to this server directly.
TRUSTED_PROXIES=

# Optional: fixed password for DemoSeeder users (local only). A random one is printed if empty.
DEMO_USER_PASSWORD=
